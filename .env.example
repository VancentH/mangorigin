# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API base URL (used by src/api/private.api.js and public.api.js)
VUE_APP_API_SERVER_URL=http://localhost:8080/mangorigin

# Axios request timeout in milliseconds (used by src/api/private.api.js and public.api.js)
VUE_APP_API_TIMEOUT=60000
